{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/", "destination": "/index.dc.html" },
    { "source": "/services", "destination": "/Services.dc.html" },
    { "source": "/adu-models", "destination": "/ADU%20Models.dc.html" },
    { "source": "/adu-model", "destination": "/ADU%20Model.dc.html" },
    { "source": "/catalog", "destination": "/Catalog.dc.html" },
    { "source": "/about", "destination": "/About.dc.html" },
    { "source": "/contact", "destination": "/Contact.dc.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
