{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/", "destination": "/index.dc.html" },
    { "source": "/services", "destination": "/services.dc.html" },
    { "source": "/adu-models", "destination": "/adu-models.dc.html" },
    { "source": "/adu-model", "destination": "/adu-model.dc.html" },
    { "source": "/catalog", "destination": "/catalog.dc.html" },
    { "source": "/about", "destination": "/about.dc.html" },
    { "source": "/contact", "destination": "/contact.dc.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
